<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %> · Quick Menu</title>
<meta name="description" content="<%= description %>" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
  rel="stylesheet"
/>
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        fontFamily: {
          sans: ['Manrope', 'system-ui', 'sans-serif']
        }
      }
    }
  };
</script>
<style>
  :root {
    color-scheme: dark;
  }

  html {
    scroll-behavior: smooth;
    background: #12141a;
  }

  body {
    /* w-screen (100vw) conta a largura da scrollbar vertical, o que por si so
       criava uma scrollbar horizontal nesta pagina. "clip" corta o transbordo
       sem criar um contentor de scroll proprio — "hidden" fazia o overflow-y
       tornar-se "auto" implicitamente (regra da spec), transformando o body
       num scroll container separado do html e sobrando ~32px fantasma no
       fundo da pagina. */
    overflow-x: clip;
    background: radial-gradient(ellipse 80% 50% at 50% -10%, rgba(45, 212, 191, 0.08), transparent), #12141a;
    -webkit-font-smoothing: antialiased;
  }
</style>
