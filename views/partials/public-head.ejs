<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %> · Quick Menu</title>
<meta name="description" content="<%= description %>" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
  rel="stylesheet"
/>
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        fontFamily: {
          sans: ['Manrope', 'system-ui', 'sans-serif']
        }
      }
    }
  };
</script>
<style>
  :root {
    color-scheme: dark;
  }

  html {
    scroll-behavior: smooth;
    background: #12141a;
  }

  body {
    /* w-screen (100vw) conta a largura da scrollbar vertical, o que por si so
       criava uma scrollbar horizontal nesta pagina. "clip" corta o transbordo
       sem criar um contentor de scroll proprio — "hidden" fazia o overflow-y
       tornar-se "auto" implicitamente (regra da spec), transformando o body
       num scroll container separado do html e sobrando ~32px fantasma no
       fundo da pagina. */
    overflow-x: clip;
    /* Fade vertical continuo pela pagina toda (nao um por seccao), escuro no
       topo e a clarear ligeiramente para lá do meio — depois a onda SVG no
       topo do footer (public-footer.ejs) e que faz o salto final para
       branco. As duas coisas juntas: o fade da a sensacao continua ao
       scrollar, a onda da a forma organica mesmo em cima do footer.
       (Tem de ser vertical, nao diagonal: um angulo em 135deg cria linhas de
       iso-cor inclinadas — numa pagina muito mais alta que larga isso faz o
       lado esquerdo e direito do ecrã mostrarem tons ligeiramente diferentes
       à mesma altura, o que se via como uma "costura" suja mesmo por cima do
       footer.) */
    background:
      radial-gradient(ellipse 80% 50% at 50% -10%, rgba(45, 212, 191, 0.08), transparent),
      linear-gradient(
        180deg,
        #12141a 0%,
        #12141a 55%,
        #1b1f28 75%,
        #262c37 90%,
        #2f3542 100%
      );
    -webkit-font-smoothing: antialiased;
  }
</style>
