<header class="sticky top-4 z-50 mx-auto w-full max-w-5xl px-4 sm:px-6">
  <div class="rounded-3xl border border-white/10 bg-white/[0.06] shadow-lg shadow-black/30 backdrop-blur-md">
    <div class="flex items-center justify-between px-5 py-3">
      <a href="/" class="flex items-center">
        <img src="/logo-horizontal.png" alt="Quick Menu" class="h-9 w-auto" />
      </a>

      <nav class="hidden items-center gap-6 text-xs font-semibold uppercase tracking-[0.18em] text-neutral-300 sm:flex">
        <a href="/#negocios" class="transition hover:text-teal-300">Negócios</a>
        <a href="/pessoal" class="transition hover:text-teal-300">Pessoal</a>
        <a href="/sobre" class="transition hover:text-teal-300">Sobre Nós</a>
        <a href="/parcerias" class="transition hover:text-teal-300">Parcerias</a>
      </nav>

      <button
        id="nav-toggle"
        type="button"
        class="flex h-8 w-8 items-center justify-center text-neutral-300 transition hover:text-teal-300 sm:hidden"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="nav-mobile-menu"
      >
        <svg id="nav-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="nav-icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav id="nav-mobile-menu" class="hidden border-t border-white/10 px-3 py-3 text-sm font-semibold uppercase tracking-[0.15em] text-neutral-300 sm:hidden">
      <a href="/#negocios" class="block rounded-xl px-3 py-2.5 transition hover:bg-white/5 hover:text-teal-300">Negócios</a>
      <a href="/pessoal" class="block rounded-xl px-3 py-2.5 transition hover:bg-white/5 hover:text-teal-300">Pessoal</a>
      <a href="/sobre" class="block rounded-xl px-3 py-2.5 transition hover:bg-white/5 hover:text-teal-300">Sobre Nós</a>
      <a href="/parcerias" class="block rounded-xl px-3 py-2.5 transition hover:bg-white/5 hover:text-teal-300">Parcerias</a>
    </nav>
  </div>
</header>

<script>
  const navToggle = document.getElementById('nav-toggle');
  const navMobileMenu = document.getElementById('nav-mobile-menu');
  const navIconOpen = document.getElementById('nav-icon-open');
  const navIconClose = document.getElementById('nav-icon-close');

  navToggle.addEventListener('click', () => {
    const willOpen = navMobileMenu.classList.contains('hidden');
    navMobileMenu.classList.toggle('hidden', !willOpen);
    navIconOpen.classList.toggle('hidden', willOpen);
    navIconClose.classList.toggle('hidden', !willOpen);
    navToggle.setAttribute('aria-expanded', String(willOpen));
  });
</script>
