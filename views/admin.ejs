<!DOCTYPE html>
<html lang="pt-PT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>NFC Restaurante Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <link
      href="https://cdn.jsdelivr.net/npm/daisyui@4.12.24/dist/full.min.css"
      rel="stylesheet"
      type="text/css"
    />
    <style>
      :root {
        color-scheme: dark;
      }

      body {
        background: linear-gradient(135deg, #0f172a 0%, #1a1f3a 50%, #0d2d2d 100%);
      }

      .status-active {
        background: rgba(16, 185, 129, 0.1);
        border-color: #10b981;
      }

      .status-paused {
        background: rgba(217, 119, 6, 0.1);
        border-color: #d97706;
      }

      .status-offline {
        background: rgba(100, 116, 139, 0.1);
        border-color: #64748b;
      }

      .dot-active {
        background-color: #10b981;
      }

      .dot-paused {
        background-color: #d97706;
      }

      .dot-offline {
        background-color: #64748b;
      }

      .status-order-pending {
        background: rgba(217, 119, 6, 0.1);
        border-color: #d97706;
      }

      .status-order-contacted {
        background: rgba(59, 130, 246, 0.1);
        border-color: #3b82f6;
      }

      .status-order-done {
        background: rgba(16, 185, 129, 0.1);
        border-color: #10b981;
      }

      .dot-order-pending {
        background-color: #d97706;
      }

      .dot-order-contacted {
        background-color: #3b82f6;
      }

      .dot-order-done {
        background-color: #10b981;
      }
    </style>
  </head>
  <body class="min-h-screen text-slate-100">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <% if (!authenticated) { %>
      <div class="mx-auto mt-10 w-full max-w-md">
        <div class="rounded-2xl border border-teal-900/30 bg-slate-900/80 p-8 shadow-2xl backdrop-blur">
          <div class="mb-8">
            <p class="mb-3 inline-flex rounded-full bg-teal-500/20 px-3 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-teal-300">
              Painel Admin
            </p>
            <h1 class="text-3xl font-black tracking-tight text-white">NFC Restaurante</h1>
            <p class="mt-3 text-sm leading-6 text-slate-400">
              Entra com a password para gerir restaurantes, cartões e estatísticas.
            </p>
          </div>

          <% if (error) { %>
          <div class="alert mb-5 border-0 border-l-4 border-red-500 bg-red-500/20 text-red-200">
            <span><%= error %></span>
          </div>
          <% } %>

          <form action="/admin/login" method="POST" class="space-y-5">
            <label class="form-control w-full">
              <div class="label px-0">
                <span class="label-text font-semibold text-slate-300">Password</span>
              </div>
              <input
                type="password"
                name="password"
                placeholder="Introduz a password"
                class="input input-bordered h-12 w-full border-slate-700 bg-slate-800 text-white placeholder-slate-500"
                required
              />
            </label>

            <button class="btn h-12 w-full border-0 bg-teal-600 text-white hover:bg-teal-700">
              Entrar no painel
            </button>
          </form>
        </div>
      </div>
      <% } else { %>
      <div class="mb-6 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="mb-3 inline-flex rounded-full bg-teal-500/20 px-3 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-teal-300">
            <%= activeView === 'orders' ? 'Gestão de Pedidos' : 'Dashboard Analytics' %>
          </p>
          <h1 class="text-4xl font-black tracking-tight text-white">NFC Restaurante</h1>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-400">
            <%= activeView === 'orders'
              ? 'Pedidos de cartões pessoais recebidos pelo formulário público.'
              : 'Visualiza o status em tempo real dos teus restaurantes com estatísticas diárias por cartão.' %>
          </p>
        </div>

        <form action="/admin/logout" method="POST">
          <button class="btn btn-sm rounded-full border-0 bg-slate-700 text-slate-200 hover:bg-slate-600">
            Logout
          </button>
        </form>
      </div>

      <div class="mb-8 inline-flex flex-wrap gap-1 rounded-full border border-slate-700/50 bg-slate-800/40 p-1 backdrop-blur">
        <a
          href="/admin?view=restaurants"
          class="rounded-full px-5 py-2.5 text-sm font-semibold transition <%= activeView === 'restaurants' ? 'bg-teal-600 text-white shadow' : 'text-slate-300 hover:bg-slate-700/60 hover:text-white' %>"
        >
          Restaurantes
        </a>
        <a
          href="/admin?view=orders"
          class="inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold transition <%= activeView === 'orders' ? 'bg-teal-600 text-white shadow' : 'text-slate-300 hover:bg-slate-700/60 hover:text-white' %>"
        >
          Pedidos Pessoais
          <% if (orderCounts.pending > 0) { %>
          <span class="inline-flex h-5 min-w-[1.25rem] items-center justify-center rounded-full bg-amber-500 px-1.5 text-xs font-bold text-white">
            <%= orderCounts.pending %>
          </span>
          <% } %>
        </a>
      </div>

      <% if (error) { %>
      <div class="alert mb-5 border-0 border-l-4 border-red-500 bg-red-500/20 text-red-200">
        <span><%= error %></span>
      </div>
      <% } %>

      <% if (success) { %>
      <div class="alert mb-5 border-0 border-l-4 border-emerald-500 bg-emerald-500/20 text-emerald-200">
        <span><%= success %></span>
      </div>
      <% } %>

      <% if (activeView === 'orders') { %>

      <section class="mb-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-xl border border-slate-700/50 bg-slate-800/40 p-5 backdrop-blur">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">Pendentes</p>
          <p class="mt-3 text-3xl font-black text-amber-400"><%= orderCounts.pending %></p>
          <p class="mt-2 text-xs text-slate-500">A aguardar contacto</p>
        </div>
        <div class="rounded-xl border border-slate-700/50 bg-slate-800/40 p-5 backdrop-blur">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">Cartões Pendentes</p>
          <p class="mt-3 text-3xl font-black text-amber-400"><%= orderCounts.pendingCardsQuantity %></p>
          <p class="mt-2 text-xs text-slate-500">Unidades por confirmar</p>
        </div>
        <div class="rounded-xl border border-slate-700/50 bg-slate-800/40 p-5 backdrop-blur">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">Últimos 7 Dias</p>
          <p class="mt-3 text-3xl font-black text-teal-300"><%= orderCounts.last7Days %></p>
          <p class="mt-2 text-xs text-slate-500">Novos pedidos</p>
        </div>
        <div class="rounded-xl border border-slate-700/50 bg-slate-800/40 p-5 backdrop-blur">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">Total</p>
          <p class="mt-3 text-3xl font-black text-emerald-400"><%= orderCounts.all %></p>
          <p class="mt-2 text-xs text-slate-500">Pedidos recebidos</p>
        </div>
      </section>

      <section class="rounded-2xl border border-slate-700/50 bg-slate-800/40 p-6 backdrop-blur">
        <div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <p class="mb-3 inline-flex rounded-full bg-teal-500/20 px-3 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-teal-300">
              Formulário Pessoal
            </p>
            <h2 class="text-3xl font-black tracking-tight text-white">Pedidos de cartão</h2>
            <p class="mt-2 text-sm leading-6 text-slate-400">
              Pedidos enviados pelo formulário em /pessoal.
            </p>
          </div>

          <div class="flex flex-wrap gap-2">
            <a
              href="/admin?view=orders&orders=pending"
              class="btn btn-sm rounded-full border-0 <%= orderStatusFilter === 'pending' ? 'bg-amber-600 text-white hover:bg-amber-700' : 'bg-slate-700 text-slate-200 hover:bg-slate-600' %>"
            >
              Pendentes (<%= orderCounts.pending %>)
            </a>
            <a
              href="/admin?view=orders&orders=contacted"
              class="btn btn-sm rounded-full border-0 <%= orderStatusFilter === 'contacted' ? 'bg-blue-600 text-white hover:bg-blue-700' : 'bg-slate-700 text-slate-200 hover:bg-slate-600' %>"
            >
              Contactados (<%= orderCounts.contacted %>)
            </a>
            <a
              href="/admin?view=orders&orders=done"
              class="btn btn-sm rounded-full border-0 <%= orderStatusFilter === 'done' ? 'bg-emerald-600 text-white hover:bg-emerald-700' : 'bg-slate-700 text-slate-200 hover:bg-slate-600' %>"
            >
              Concluídos (<%= orderCounts.done %>)
            </a>
            <a
              href="/admin?view=orders&orders=all"
              class="btn btn-sm rounded-full border-0 <%= orderStatusFilter === 'all' ? 'bg-teal-600 text-white hover:bg-teal-700' : 'bg-slate-700 text-slate-200 hover:bg-slate-600' %>"
            >
              Todos (<%= orderCounts.all %>)
            </a>
          </div>
        </div>

        <%
          function relativeTimeLabel(dateValue) {
            const diffMs = Date.now() - new Date(dateValue).getTime();
            const diffMinutes = Math.floor(diffMs / 60000);

            if (diffMinutes < 1) return 'agora mesmo';
            if (diffMinutes < 60) return `há ${diffMinutes} min`;

            const diffHours = Math.floor(diffMinutes / 60);
            if (diffHours < 24) return `há ${diffHours}h`;

            const diffDays = Math.floor(diffHours / 24);
            if (diffDays < 7) return `há ${diffDays}d`;

            return `há ${Math.floor(diffDays / 7)}sem`;
          }
        %>

        <% if (!orders.length) { %>
        <div class="rounded-xl border border-dashed border-slate-600 bg-slate-900/50 p-12 text-center">
          <p class="text-sm text-slate-400">Sem pedidos nesta categoria.</p>
        </div>
        <% } else { %>
        <div class="space-y-4">
          <% orders.forEach((order) => { %>
          <div class="status-order-<%= order.status %> rounded-xl border-2 p-5">
            <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="text-lg font-bold text-white"><%= order.full_name %></h3>
                  <span class="dot-order-<%= order.status %> h-2.5 w-2.5 rounded-full"></span>
                </div>
                <p class="mt-1 text-xs text-slate-400">
                  <%= new Date(order.created_at).toLocaleString('pt-PT', { timeZone: appTimezone, dateStyle: 'short', timeStyle: 'short' }) %>
                  · <span class="font-semibold text-slate-300"><%= relativeTimeLabel(order.created_at) %></span>
                </p>
              </div>
              <span class="rounded-full bg-black/30 px-3 py-1 text-xs font-semibold text-slate-200">
                <%= order.quantity %> <%= order.quantity === 1 ? 'cartão' : 'cartões' %>
              </span>
            </div>

            <div class="grid gap-3 sm:grid-cols-2">
              <div class="rounded-lg bg-black/30 p-3">
                <p class="text-xs text-slate-400">Email</p>
                <a href="mailto:<%= order.email %>" class="mt-1 block truncate text-sm font-semibold text-teal-300 hover:text-teal-200"><%= order.email %></a>
              </div>
              <% if (order.phone) { %>
              <div class="rounded-lg bg-black/30 p-3">
                <p class="text-xs text-slate-400">Telefone</p>
                <a href="tel:<%= order.phone %>" class="mt-1 block text-sm font-semibold text-teal-300 hover:text-teal-200"><%= order.phone %></a>
              </div>
              <% } %>
              <% if (order.company || order.role) { %>
              <div class="rounded-lg bg-black/30 p-3">
                <p class="text-xs text-slate-400">Empresa / Cargo</p>
                <p class="mt-1 text-sm text-slate-200"><%= [order.company, order.role].filter(Boolean).join(' — ') %></p>
              </div>
              <% } %>
              <% if (order.social_link) { %>
              <div class="rounded-lg bg-black/30 p-3">
                <p class="text-xs text-slate-400">Link</p>
                <a href="<%= order.social_link %>" target="_blank" rel="noreferrer" class="mt-1 block truncate text-sm font-semibold text-teal-300 hover:text-teal-200"><%= order.social_link %></a>
              </div>
              <% } %>
            </div>

            <% if (order.notes) { %>
            <div class="mt-3 rounded-lg bg-black/30 p-3">
              <p class="text-xs text-slate-400">Notas</p>
              <p class="mt-1 whitespace-pre-line text-sm text-slate-200"><%= order.notes %></p>
            </div>
            <% } %>

            <% if (order.attachment_urls && order.attachment_urls.length) { %>
            <div class="mt-3 flex flex-wrap gap-2">
              <% order.attachment_urls.forEach((url) => { %>
              <a href="<%= url %>" target="_blank" rel="noreferrer" class="block h-16 w-16 overflow-hidden rounded-lg border border-slate-600">
                <img src="<%= url %>" alt="Anexo" class="h-full w-full object-cover" />
              </a>
              <% }) %>
            </div>
            <% } %>

            <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-slate-700/50 pt-4">
              <% ['pending', 'contacted', 'done'].filter((s) => s !== order.status).forEach((s) => { %>
              <form action="/admin/orders/<%= order.id %>/status" method="POST">
                <input type="hidden" name="filter" value="<%= orderStatusFilter %>" />
                <input type="hidden" name="status" value="<%= s %>" />
                <button class="btn btn-xs rounded-full border-0 bg-slate-700 text-slate-200 hover:bg-slate-600">
                  <%= s === 'pending' ? 'Marcar pendente' : s === 'contacted' ? 'Marcar contactado' : 'Marcar concluído' %>
                </button>
              </form>
              <% }) %>
              <form action="/admin/orders/<%= order.id %>/delete" method="POST" class="ml-auto">
                <input type="hidden" name="filter" value="<%= orderStatusFilter %>" />
                <button
                  class="btn btn-xs rounded-full border-0 bg-red-700 text-white hover:bg-red-600"
                  onclick="return confirm('Apagar este pedido?');"
                >
                  Apagar
                </button>
              </form>
            </div>
          </div>
          <% }) %>
        </div>
        <% } %>
      </section>

      <% } else { %>

      <section class="mb-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
        <div class="rounded-xl border border-slate-700/50 bg-slate-800/40 p-5 backdrop-blur">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">Restaurantes</p>
          <p class="mt-3 text-3xl font-black text-teal-300"><%= overview.totalLinks %></p>
          <p class="mt-2 text-xs text-slate-500">Ativos</p>
        </div>
        <div class="rounded-xl border border-slate-700/50 bg-slate-800/40 p-5 backdrop-blur">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">Cartões Totais</p>
          <p class="mt-3 text-3xl font-black text-teal-300"><%= overview.totalCards %></p>
          <p class="mt-2 text-xs text-slate-500">Registados</p>
        </div>
        <div class="rounded-xl border border-slate-700/50 bg-slate-800/40 p-5 backdrop-blur">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">Cartões Ativos</p>
          <p class="mt-3 text-3xl font-black text-emerald-400"><%= overview.totalActiveCards %></p>
          <p class="mt-2 text-xs text-slate-500">Online</p>
        </div>
        <div class="rounded-xl border border-slate-700/50 bg-slate-800/40 p-5 backdrop-blur">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">Hoje</p>
          <p class="mt-3 text-3xl font-black text-emerald-400"><%= overview.totalOpensToday %></p>
          <p class="mt-2 text-xs text-slate-500">Aberturas</p>
        </div>
        <div class="rounded-xl border border-slate-700/50 bg-slate-800/40 p-5 backdrop-blur">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">7 Dias</p>
          <p class="mt-3 text-3xl font-black text-teal-300"><%= overview.totalOpensLast7Days %></p>
          <p class="mt-2 text-xs text-slate-500">Total</p>
        </div>
      </section>

      <div class="grid gap-8 xl:grid-cols-[1fr_1.5fr]">
        <section class="rounded-2xl border border-slate-700/50 bg-slate-800/40 p-6 backdrop-blur">
          <div class="mb-6">
            <p class="mb-3 inline-flex rounded-full bg-teal-500/20 px-3 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-teal-300">
              Novo Restaurante
            </p>
            <h2 class="text-2xl font-black tracking-tight text-white">Criar redirect</h2>
            <p class="mt-2 text-sm leading-6 text-slate-400">
              Cria o restaurante base. Os cartões individuais ficam abaixo quando selecionares.
            </p>
          </div>

          <form action="/admin/links" method="POST" class="space-y-4">
            <label class="form-control">
              <div class="label px-0">
                <span class="label-text font-semibold text-slate-300">Nome do Restaurante</span>
              </div>
              <input
                type="text"
                name="restaurant_name"
                value="<%= formData.restaurant_name || '' %>"
                placeholder="Ex: Soft Lounge"
                class="input input-bordered w-full border-slate-600 bg-slate-700 text-white placeholder-slate-500"
                required
              />
            </label>

            <label class="form-control">
              <div class="label px-0">
                <span class="label-text font-semibold text-slate-300">Slug</span>
              </div>
              <input
                type="text"
                name="slug"
                value="<%= formData.slug || '' %>"
                placeholder="Ex: soft-lounge"
                class="input input-bordered w-full border-slate-600 bg-slate-700 text-white placeholder-slate-500"
                required
              />
            </label>

            <label class="form-control">
              <div class="label px-0">
                <span class="label-text font-semibold text-slate-300">URL de Destino</span>
              </div>
              <input
                type="url"
                name="destination_url"
                value="<%= formData.destination_url || '' %>"
                placeholder="https://..."
                class="input input-bordered w-full border-slate-600 bg-slate-700 text-white placeholder-slate-500"
                required
              />
            </label>

            <button class="btn h-12 w-full border-0 bg-teal-600 text-white hover:bg-teal-700">
              Criar restaurante
            </button>
          </form>
        </section>

        <section id="restaurant-history" class="rounded-2xl border border-slate-700/50 bg-slate-800/40 p-6 backdrop-blur">
          <div class="mb-5 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div>
              <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-400">Histórico do Restaurante</p>
              <h2 class="mt-2 text-2xl font-black tracking-tight text-white">
                <%= selectedLink ? selectedLink.restaurant_name : 'Seleciona um restaurante' %>
              </h2>
              <p class="mt-2 text-sm text-slate-400">
                Totais diários nos últimos <%= selectedLinkHistory.labels.length || 0 %> dias.
              </p>
            </div>
            <% if (selectedLink) { %>
            <div class="rounded-lg bg-slate-900/60 px-4 py-3 text-xs border border-slate-600 backdrop-blur">
              <span class="text-slate-400">Link:</span> <span class="font-mono text-teal-300"><%= baseUrl %>/go/<%= selectedLink.slug %></span>
            </div>
            <% } %>
          </div>

          <div class="rounded-lg border border-slate-700 bg-slate-900/50 p-4">
            <canvas id="restaurantHistoryChart" height="120"></canvas>
          </div>
        </section>
      </div>

      <section class="mt-8 rounded-2xl border border-slate-700/50 bg-slate-800/40 p-6 backdrop-blur">
        <div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-400">Restaurantes</p>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-white">Dashboard por restaurante</h2>
          </div>
          <div class="rounded-xl border border-slate-700/50 bg-slate-900/60 px-4 py-3 text-xs text-slate-300 backdrop-blur">
            <span class="text-slate-500">Link:</span> <span class="font-mono text-teal-300"><%= baseUrl %>/go/slug</span>
          </div>
        </div>

        <% if (!links.length) { %>
        <div class="rounded-xl border border-dashed border-slate-600 bg-slate-900/50 p-12 text-center">
          <p class="text-sm text-slate-400">Ainda não existem restaurantes. Cria o primeiro no formulário acima.</p>
        </div>
        <% } else { %>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <% links.forEach((link) => { %>
          <div class="status-<%= link.status %> group rounded-xl border-2 p-5 transition hover:shadow-lg">
            <div class="mb-4 flex items-start justify-between">
              <div class="flex-1">
                <div class="flex items-center gap-2">
                  <h3 class="text-lg font-bold text-white"><%= link.restaurant_name %></h3>
                  <div class="dot-<%= link.status %> h-3 w-3 rounded-full"></div>
                </div>
                <p class="mt-1 text-xs font-semibold text-slate-300"><%= link.status_label %></p>
              </div>
              <div class="flex gap-1 opacity-0 transition group-hover:opacity-100">
                <a
                  href="/admin?link=<%= link.id %>"
                  class="btn btn-xs border-0 bg-slate-700 text-slate-200 hover:bg-slate-600"
                >
                  Ver
                </a>
              </div>
            </div>

            <div class="space-y-3">
              <div class="grid grid-cols-2 gap-3">
                <div class="rounded-lg bg-black/30 p-3">
                  <p class="text-xs text-slate-400">Hoje</p>
                  <p class="mt-1 text-2xl font-bold text-emerald-400"><%= link.opens_today %></p>
                </div>
                <div class="rounded-lg bg-black/30 p-3">
                  <p class="text-xs text-slate-400">7 Dias</p>
                  <p class="mt-1 text-2xl font-bold text-teal-400"><%= link.opens_last_7_days %></p>
                </div>
              </div>

              <div class="rounded-lg bg-black/30 p-3">
                <p class="text-xs text-slate-400">Cartões</p>
                <p class="mt-1 font-mono text-sm text-slate-300"><%= link.card_count %>/<%= link.total_cards %> ativos</p>
              </div>

              <div class="rounded-lg bg-black/30 p-3">
                <p class="text-xs text-slate-400">Slug</p>
                <p class="mt-1 font-mono text-xs text-teal-300"><%= link.slug %></p>
              </div>
            </div>

            <form id="update-link-<%= link.id %>" action="/admin/links/<%= link.id %>/update" method="POST" class="mt-4 hidden space-y-3">
              <input
                type="text"
                name="restaurant_name"
                value="<%= editingId === link.id ? formData.restaurant_name || link.restaurant_name : link.restaurant_name %>"
                class="input input-bordered input-sm w-full border-slate-600 bg-slate-700 text-white"
              />
              <input
                type="text"
                name="slug"
                value="<%= editingId === link.id ? formData.slug || link.slug : link.slug %>"
                class="input input-bordered input-sm w-full border-slate-600 bg-slate-700 text-white"
              />
              <input
                type="url"
                name="destination_url"
                value="<%= editingId === link.id ? formData.destination_url || link.destination_url : link.destination_url %>"
                class="input input-bordered input-sm w-full border-slate-600 bg-slate-700 text-white"
              />
              <div class="flex gap-2">
                <button class="btn btn-sm border-0 flex-1 bg-teal-600 text-white hover:bg-teal-700">Guardar</button>
                <form action="/admin/links/<%= link.id %>/delete" method="POST" class="flex-1">
                  <button
                    class="btn btn-sm w-full border-0 bg-red-600 text-white hover:bg-red-700"
                    onclick="return confirm('Apagar restaurante e todos os dados?');"
                  >
                    Apagar
                  </button>
                </form>
              </div>
            </form>

            <button
              type="button"
              onclick="document.getElementById('update-link-<%= link.id %>').classList.toggle('hidden'); this.classList.toggle('hidden');"
              class="btn btn-sm btn-ghost w-full mt-2 text-slate-300"
            >
              Editar
            </button>
          </div>
          <% }) %>
        </div>
        <% } %>
      </section>

      <section id="cards" class="mt-8 grid gap-8 xl:grid-cols-[1fr_1.35fr]">
        <div class="rounded-2xl border border-slate-700/50 bg-slate-800/40 p-6 backdrop-blur">
          <div class="mb-6">
            <p class="mb-3 inline-flex rounded-full bg-teal-500/20 px-3 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-teal-300">
              Cartões NFC
            </p>
            <h2 class="text-2xl font-black tracking-tight text-white">
              <%= selectedLink ? `Novo cartão para ${selectedLink.restaurant_name}` : 'Seleciona um restaurante' %>
            </h2>
            <p class="mt-2 text-sm leading-6 text-slate-400">
              Cria cartões com tokens únicos para rastrear aberturas por cartão.
            </p>
          </div>

          <% if (selectedLink) { %>
          <form action="/admin/links/<%= selectedLink.id %>/cards" method="POST" class="space-y-4">
            <label class="form-control">
              <div class="label px-0">
                <span class="label-text font-semibold text-slate-300">Quantidade de cartões</span>
              </div>
              <input
                type="number"
                name="quantity"
                min="1"
                max="50"
                value="<%= cardFormData.quantity || 1 %>"
                class="input input-bordered w-full border-slate-600 bg-slate-700 text-white placeholder-slate-500"
              />
              <div class="label px-0">
                <span class="label-text-alt text-slate-400 text-xs">Gera automaticamente como "<%= selectedLink.restaurant_name %> 1", "<%= selectedLink.restaurant_name %> 2"...</span>
              </div>
            </label>

            <label class="form-control">
              <div class="label px-0">
                <span class="label-text font-semibold text-slate-300">Etiqueta opcional</span>
              </div>
              <input
                type="text"
                name="label"
                value="<%= cardFormData.label || '' %>"
                placeholder="Opcional para 1 cartão"
                class="input input-bordered w-full border-slate-600 bg-slate-700 text-white placeholder-slate-500"
              />
            </label>

            <label class="form-control">
              <div class="label px-0">
                <span class="label-text font-semibold text-slate-300">Token opcional</span>
              </div>
              <input
                type="text"
                name="public_token"
                value="<%= cardFormData.public_token || '' %>"
                placeholder="Opcional para 1 cartão"
                class="input input-bordered w-full border-slate-600 bg-slate-700 text-white placeholder-slate-500"
              />
            </label>

            <label class="form-control">
              <div class="label px-0">
                <span class="label-text font-semibold text-slate-300">Estado</span>
              </div>
              <select name="is_active" class="select select-bordered border-slate-600 bg-slate-700 text-white">
                <option value="true" <%= cardFormData.is_active === false ? '' : 'selected' %>>Ativo</option>
                <option value="false" <%= cardFormData.is_active === false ? 'selected' : '' %>>Inativo</option>
              </select>
            </label>

            <button class="btn h-12 w-full border-0 bg-teal-600 text-white hover:bg-teal-700">
              Criar cartões
            </button>
          </form>
          <% } else { %>
          <div class="rounded-xl border border-dashed border-slate-600 bg-slate-900/50 p-6 text-center">
            <p class="text-sm text-slate-400">Seleciona um restaurante para criar cartões</p>
          </div>
          <% } %>
        </div>

        <div id="card-history" class="rounded-2xl border border-slate-700/50 bg-slate-800/40 p-6 backdrop-blur">
          <div class="mb-5">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-400">Histórico do Cartão</p>
            <h2 class="mt-2 text-2xl font-black tracking-tight text-white">
              <%= selectedCard ? (selectedCard.label || selectedCard.public_token) : 'Seleciona um cartão' %>
            </h2>
            <p class="mt-2 text-sm text-slate-400">
              Aberturas diárias do cartão selecionado.
            </p>
          </div>

          <div class="rounded-lg border border-slate-700 bg-slate-900/50 p-4">
            <canvas id="cardHistoryChart" height="120"></canvas>
          </div>
        </div>
      </section>

      <section class="mt-8 rounded-2xl border border-slate-700/50 bg-slate-800/40 p-6 backdrop-blur">
        <div class="mb-5">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-400">Cartões</p>
          <h2 class="text-2xl font-black tracking-tight text-white">
            <%= selectedLink ? selectedLink.restaurant_name : 'Seleciona um restaurante' %>
          </h2>
        </div>

        <div class="overflow-x-auto rounded-lg border border-slate-700">
          <table class="table table-sm">
            <thead class="bg-slate-900/50 text-slate-400">
              <tr>
                <th class="text-slate-400">Etiqueta</th>
                <th class="text-slate-400">Token</th>
                <th class="text-slate-400">Estado</th>
                <th class="text-slate-400">Hoje</th>
                <th class="text-slate-400">7 Dias</th>
                <th class="text-slate-400">Link</th>
                <th class="text-right text-slate-400">Ações</th>
              </tr>
            </thead>
            <tbody class="bg-slate-800/30">
              <% if (!cards.length) { %>
              <tr>
                <td colspan="7" class="py-8 text-center text-sm text-slate-500">
                  Sem cartões para este restaurante
                </td>
              </tr>
              <% } %>

              <% cards.forEach((card) => { %>
              <tr class="align-top border-t border-slate-700/50">
                <td class="min-w-[150px]">
                  <form id="update-card-<%= card.id %>" action="/admin/cards/<%= card.id %>/update" method="POST">
                    <input type="hidden" name="link_id" value="<%= selectedLink ? selectedLink.id : '' %>" />
                    <input
                      type="text"
                      name="label"
                      value="<%= editingCardId === card.id ? cardFormData.label || card.label : card.label || '' %>"
                      placeholder="Label"
                      class="input input-bordered input-xs w-full border-slate-600 bg-slate-700 text-white"
                    />
                  </form>
                </td>
                <td class="min-w-[140px]">
                  <input
                    form="update-card-<%= card.id %>"
                    type="text"
                    name="public_token"
                    value="<%= editingCardId === card.id ? cardFormData.public_token || card.public_token : card.public_token %>"
                    class="input input-bordered input-xs w-full border-slate-600 bg-slate-700 text-white font-mono"
                  />
                </td>
                <td class="min-w-[100px]">
                  <select
                    form="update-card-<%= card.id %>"
                    name="is_active"
                    class="select select-bordered select-xs w-full border-slate-600 bg-slate-700 text-white"
                  >
                    <option value="true" <%= (editingCardId === card.id ? cardFormData.is_active : card.is_active) ? 'selected' : '' %>>Ativo</option>
                    <option value="false" <%= (editingCardId === card.id ? cardFormData.is_active : card.is_active) ? '' : 'selected' %>>Inativo</option>
                  </select>
                </td>
                <td class="text-sm font-semibold text-slate-300"><%= card.opens_today %></td>
                <td class="text-sm font-semibold text-slate-300"><%= card.opens_last_7_days %></td>
                <td class="min-w-[200px]">
                  <% if (selectedLink) { %>
                  <a
                    href="/go/<%= selectedLink.slug %>?card=<%= card.public_token %>"
                    target="_blank"
                    rel="noreferrer"
                    class="text-xs font-mono text-teal-400 hover:text-teal-300"
                  >
                    /go/<%= selectedLink.slug %>
                  </a>
                  <% } %>
                </td>
                <td class="w-[140px]">
                  <div class="flex justify-end gap-1">
                    <button
                      form="update-card-<%= card.id %>"
                      class="btn btn-xs border-0 bg-teal-700 text-white hover:bg-teal-600"
                    >
                      Guardar
                    </button>
                    <form action="/admin/cards/<%= card.id %>/delete" method="POST">
                      <input type="hidden" name="link_id" value="<%= selectedLink ? selectedLink.id : '' %>" />
                      <button
                        class="btn btn-xs border-0 bg-red-700 text-white hover:bg-red-600"
                        onclick="return confirm('Apagar cartão?');"
                      >
                        Apagar
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>

      <%
        // JSON.stringify nao escapa "<", por isso um nome de restaurante tipo
        // </script><script>... conseguia partir para fora desta tag. Trocar
        // "<" por < neutraliza isso sem mudar o valor em JS.
        function safeJson(value) {
          return JSON.stringify(value).replace(/</g, '\\u003c');
        }
      %>
      <script>
        const restaurantHistoryLabels = <%- safeJson(selectedLinkHistory.labels || []) %>;
        const restaurantHistoryValues = <%- safeJson(selectedLinkHistory.values || []) %>;
        const cardHistoryLabels = <%- safeJson(selectedCardHistory.labels || []) %>;
        const cardHistoryValues = <%- safeJson(selectedCardHistory.values || []) %>;
        const selectedRestaurantName = <%- safeJson(selectedLink ? selectedLink.restaurant_name : 'Restaurante') %>;
        const selectedCardName = <%- safeJson(selectedCard ? (selectedCard.label || selectedCard.public_token) : 'Cartão') %>;

        function renderHistoryChart(elementId, labels, values, datasetLabel, color) {
          const chartCanvas = document.getElementById(elementId);

          if (!chartCanvas || !labels.length) {
            return;
          }

          new Chart(chartCanvas, {
            type: 'line',
            data: {
              labels,
              datasets: [
                {
                  label: datasetLabel,
                  data: values,
                  borderColor: color,
                  backgroundColor: color === '#0d9488' ? 'rgba(13, 148, 136, 0.15)' : 'rgba(59, 130, 246, 0.15)',
                  fill: true,
                  tension: 0.4,
                  pointRadius: 4,
                  pointHoverRadius: 6,
                  pointBackgroundColor: color,
                  pointBorderColor: '#1e293b',
                  pointBorderWidth: 2
                }
              ]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              scales: {
                y: {
                  beginAtZero: true,
                  ticks: {
                    precision: 0,
                    color: '#94a3b8'
                  },
                  grid: {
                    color: 'rgba(71, 85, 105, 0.2)'
                  }
                },
                x: {
                  ticks: {
                    color: '#94a3b8'
                  },
                  grid: {
                    display: false
                  }
                }
              },
              plugins: {
                legend: {
                  labels: {
                    color: '#cbd5e1'
                  }
                }
              }
            }
          });
        }

        renderHistoryChart(
          'restaurantHistoryChart',
          restaurantHistoryLabels,
          restaurantHistoryValues,
          `Aberturas - ${selectedRestaurantName}`,
          '#0d9488'
        );

        renderHistoryChart(
          'cardHistoryChart',
          cardHistoryLabels,
          cardHistoryValues,
          `Aberturas - ${selectedCardName}`,
          '#3b82f6'
        );
      </script>

      <% } %>
      <% } %>
    </div>
  </body>
</html>
